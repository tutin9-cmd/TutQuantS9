# === API Keys ===
POLYGON_API_KEY=your_polygon_api_key_here
LUNARCRUSH_API_KEY=your_lunarcrush_api_key_here
ARKHAM_API_KEY=your_arkham_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# === Robinhood MCP ===
ROBINHOOD_MCP_URL=http://localhost:3000
ROBINHOOD_MCP_TOKEN=your_robinhood_mcp_token_here

# === Trading Parameters ===
TOTAL_CAPITAL=250.00
MAX_POSITION_SIZE=50.00
MAX_CONCURRENT_POSITIONS=3
MAX_TRADES_PER_ASSET_24H=2

# === Risk Parameters ===
MAX_SPREAD_PCT=0.75
STOP_LOSS_ATR_MULTIPLIER=2.0
TAKE_PROFIT_PCT=8.0
TRAILING_SMA_PERIOD=20
TIME_STOP_HOURS=48

# === Weekend Blackout ===
BLACKOUT_START_DAY=friday
BLACKOUT_START_HOUR=20
BLACKOUT_END_DAY=sunday
BLACKOUT_END_HOUR=20

# === Logging ===
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
